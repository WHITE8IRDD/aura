{
  "name": "aura",
  "version": "0.3.0",
  "description": "Aura — the fastest and most secure consumer browser, with AI built in.",
  "author": "Aura",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev --noSandbox",
    "dev:verbose": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "postinstall": "electron-rebuild -f -w better-sqlite3 || exit 0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^31.3.0",
    "electron-builder": "^26.15.3",
    "electron-rebuild": "^3.2.9",
    "electron-vite": "^2.3.0",
    "png-to-ico": "^3.0.1",
    "tsx": "^4.23.13",
    "typescript": "^5.5.3",
    "vite": "^5.3.4"
  },
  "build": {
    "appId": "com.aura.browser",
    "productName": "Aura",
    "executableName": "Aura",
    "copyright": "Copyright © 2025 Aura Browser",
    "artifactName": "Aura-Setup-${version}.exe",
    "asar": true,
    "asarUnpack": [
      "**/*.node",
      "node_modules/better-sqlite3/**"
    ],
    "win": {
      "icon": "resources/icons/icon-256.png",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Aura Browser",
      "uninstallDisplayName": "Aura Browser",
      "runAfterFinish": true,
      "installerIcon": "resources/icons/icon.ico",
      "uninstallerIcon": "resources/icons/icon.ico",
      "installerHeader": "resources/icons/WITH BACKGROUND.png"
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "resources/**/*",
      "!**/*.map",
      "!node_modules/**/*.map"
    ]
  },
  "overrides": {
    "better-sqlite3": "11.7.0"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.18.2",
    "@mozilla/readability": "^0.6.0",
    "adm-zip": "^0.5.17",
    "better-sqlite3": "11.7.0",
    "cross-fetch": "^4.1.0",
    "fast-xml-parser": "^5.11.1",
    "framer-motion": "^12.40.0",
    "linkedom": "^0.18.12",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tldts": "^7.4.13"
  }
}
